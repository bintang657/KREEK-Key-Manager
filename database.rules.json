{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "auth": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "keys": {
      "$keyId": {
        ".validate": "newData.hasChildren(['key','status','createdAt']) && newData.child('status').val() in ['active','revoked']"
      }
    },
    "notifications": {
      "$notificationId": {
        ".validate": "newData.hasChildren(['title','body','createdAt'])"
      }
    },
    "update": {
      "$updateId": {
        ".validate": "newData.hasChildren(['new','link'])"
      }
    }
  }
}
